      "Barolong": "Borolong",
      "Serowe-Palapye": "Serowe Palapye",
      "Ngamiland East": "Ngami East"
    },
    "formula_gap_index": "population_2022 * (1 - household_grid_connection_pct / 100)",
    "formula_access_index": "population_2022 * household_grid_connection_pct / 100",
    "interpretation": "The indices combine a people-count population with a household connection percentage and are prioritisation indicators only; they are NOT counts of connected or unconnected people/households."
